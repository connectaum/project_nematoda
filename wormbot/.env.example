# Copy to wormbot/.env (never commit the real file)

# https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# @BotFather -> /newbot
BOT_TOKEN=
# Comma-separated Telegram user ids; EMPTY = anyone can use the bot
ALLOWED_USERS=
# Folder where users unpack the returned DLC projects (written into project_path of config.yaml)
PROJECT_PATH_PREFIX=/path/to/project_nematoda
